# Copy to .env and adjust. Everything below has a sensible default in
# docker-compose.yml, so the stack runs even with an empty .env.

# --- Postgres (shared by LiteLLM + Lago) ---
POSTGRES_USER=cheap
POSTGRES_PASSWORD=secred_pwd
POSTGRES_LITELLM_DB=litellm_db
POSTGRES_LAGO_DATABASE=lago_db

# --- LiteLLM gateway ---
LITELLM_MASTER_KEY=sk-1234-master-key-4321

# --- Inference engine ---
# pick one: llamacpp, vllm, sglang (drives --profile / COMPOSE_PROFILES)
INFERENCE_PROFILE=llamacpp

# --- Lago ---
LAGO_SECRET_KEY_BASE=change-me-in-prod

# --- External model fallbacks (optional) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# --- Model cache ---
# Leave unset to cache under ./models/hf-cache (gitignored). Set an
# absolute path here to keep the cache elsewhere.
HF_TOKEN=hf_your_token_here
#HF_CACHE_DIR=./models/hf-cache
