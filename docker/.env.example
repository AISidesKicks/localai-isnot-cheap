# Copy to .env and adjust. Everything below has a sensible default in
# docker-compose.yml, so the stack runs even with an empty .env.

# --- Postgres (shared by LiteLLM + Lago) ---
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm
POSTGRES_DB=litellm
POSTGRES_MULTIPLE_DATABASES=lago_production

# --- LiteLLM gateway ---
LITELLM_MASTER_KEY=sk-1234

# --- Lago ---
LAGO_SECRET_KEY_BASE=change-me-in-prod

# --- External model fallbacks (optional) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Model cache ---
# Leave unset to cache under docker/models/hf-cache (gitignored). Set an
# absolute path here to keep the cache elsewhere.
#HF_CACHE_DIR=./models/hf-cache
