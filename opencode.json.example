{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "phoenix": {
      "type": "remote",
      "url": "http://localhost:6006/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "victoriametrics": {
      "type": "remote",
      "url": "http://localhost:8000/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "litellm": {
      "type": "remote",
      "url": "http://localhost:4001/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "litellm-gateway": {
      "type": "remote",
      "url": "http://localhost:4000/mcp",
      "enabled": true,
      "timeout": 15000,
      "headers": {
        "x-litellm-api-key": "Bearer sk-1234-master-key-4321"
      }
    }
  }
}
